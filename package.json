{
  "name": "eisenkrieg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A mobile-first, browser-native reimagining of the carry-and-command RTS.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "selfplay": "esbuild src/tools/selfplay.ts --bundle --platform=node --format=esm --outfile=dist-tools/selfplay.mjs --log-level=error && node dist-tools/selfplay.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "icons": "node scripts/make-icons.mjs",
    "signal": "node server/signal.mjs",
    "netcheck": "node scripts/nettest.mjs",
    "spritesheet": "node scripts/spritesheet.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "ws": "^8.21.3"
  }
}
